# Copy to .env and fill in. Never commit .env.
#
# ForensiQ uses Groq through its OpenAI-compatible endpoint, so the
# course client.py works unchanged. Get a key at https://console.groq.com/keys

LLM_API_KEY=your-groq-api-key-here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# To run against the local deterministic stub instead (no key, no network):
#
# LLM_API_KEY=not-needed
# LLM_BASE_URL=local://stub
# LLM_MODEL=stub:ok
#
# Modes: ok fenced preamble malformed badshape empty refused error flaky
#        ratelimit obedient toolcall traversal neverstop badargs